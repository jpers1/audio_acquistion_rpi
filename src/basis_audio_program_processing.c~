#ifndef min
#define min(a, b) (((a) < (b)) ? (a) : (b))
#endif

typedef float SAMPLE;                 // Audio sample type

#define NUM_CHANNELS       (2)
#define SAMPLE_RATE        (48000)
#define FRAMES_PER_BUFFER  (512)
#define PA_SAMPLE_TYPE     paFloat32
#define SAMPLE_SIZE        (sizeof(float))
#define SAMPLE_SILENCE     (0.0f)
#define GAIN_FACTOR        (2.0f)

// Noise Cancel Defaults
#define DEFAULT_FILTER_LENGTH 128
#define DEFAULT_MU            0.05f
#define EPSILON               1e-6f

// We'll skip the first 1 second of stats to avoid startup pops
#define STARTUP_SKIP_FRAMES  (SAMPLE_RATE)

/******************************************************************************
 * Global for CTRL+C
 ******************************************************************************/
volatile sig_atomic_t keepRunning = 1;


/******************************************************************************
 * Timestamped sample struct
 ******************************************************************************/
typedef struct
{
    SAMPLE         sample;
    struct timespec timestamp;
} TimestampedSample;


/******************************************************************************
 * WAVE header struct
 * 
 * This minimal header is for 32-bit float audio:
 *   - audioFormat = 3  => IEEE float
 *   - bitsPerSample = 32
 ******************************************************************************/
#pragma pack(push, 1)
typedef struct
{
    /* RIFF chunk descriptor */
    char     chunkID[4];      // "RIFF"
    uint32_t chunkSize;       // 36 + subChunk2Size
    char     format[4];       // "WAVE"

    /* Sub-chunk 1: "fmt " */
    char     subChunk1ID[4];  // "fmt "
    uint32_t subChunk1Size;   // 16 for PCM
    uint16_t audioFormat;     // 3 = IEEE float
    uint16_t numChannels;
    uint32_t sampleRate;
    uint32_t byteRate;        // = sampleRate * numChannels * bitsPerSample/8
    uint16_t blockAlign;      // = numChannels * bitsPerSample/8
    uint16_t bitsPerSample;   // 32 for float

    /* Sub-chunk 2: "data" */
    char     subChunk2ID[4];  // "data"
    uint32_t subChunk2Size;   // numSamples * numChannels * bitsPerSample/8
} WavHeader;
#pragma pack(pop)


/******************************************************************************
 * NextPowerOf2 & Signal Handler
 ******************************************************************************/
static unsigned NextPowerOf2(unsigned val)
{
    val--;
    val = (val >> 1) | val;
    val = (val >> 2) | val;
    val = (val >> 4) | val;
    val = (val >> 8) | val;
    val = (val >> 16) | val;
    return ++val;
}

void sigint_handler(int sig)
{
    (void)sig;
    keepRunning = 0;
}


/******************************************************************************
 * Data Structure for Audio
 ******************************************************************************/
typedef struct
{
    PaUtilRingBuffer   ringBuffer;
    TimestampedSample *sampleData;

    // We'll hold our WAV file pointer and header
    FILE      *wavFile;
    WavHeader  wavHeader;

    // We'll keep track of how many samples have been written for finalizing
    uint64_t   totalSamplesWritten;

    // We'll also keep a separate timestamps file pointer
    FILE      *timestampFile;

    // Noise cancel flags & buffers
    int    doNoiseCancel;
    float  mu;
    int    filterLength;

    float *filterCoeffs;
    float *refHistory;
    int    refIndex;

    // Mono replication
    int    monoChannel;

} AudioData;


/******************************************************************************
 * sampleSilence
 ******************************************************************************/
static SAMPLE sampleSilence[FRAMES_PER_BUFFER * NUM_CHANNELS] = { 0.0f };


/******************************************************************************
 * WAVE Helpers
 *
 * openWavFile():
 *    - Initializes a WavHeader for 32-bit float data
 *    - Writes the header with placeholder sizes
 *    - Returns FILE*
 *
 * finalizeWavFile():
 *    - Updates chunk sizes in the header
 *    - Rewrites them at the start of the file
 *    - Closes the file
 ******************************************************************************/
static FILE* openWavFile(const char* filename, WavHeader* header)
{
    FILE* fp = fopen(filename, "wb");
    if (!fp) return NULL;

    // Fill in the WAV header fields
    memcpy(header->chunkID,     "RIFF", 4);
    memcpy(header->format,      "WAVE", 4);
    memcpy(header->subChunk1ID, "fmt ", 4);
    memcpy(header->subChunk2ID, "data", 4);

    header->subChunk1Size  = 16;       // PCM
    header->audioFormat    = 3;        // 3 = IEEE float
    header->numChannels    = NUM_CHANNELS;
    header->sampleRate     = SAMPLE_RATE;
    header->bitsPerSample  = 32;       // float 32-bit
    header->byteRate       = header->sampleRate
                             * header->numChannels
                             * (header->bitsPerSample / 8);
    header->blockAlign     = header->numChannels
                             * (header->bitsPerSample / 8);
    header->subChunk2Size  = 0;        // will fix later
    header->chunkSize      = 36 + header->subChunk2Size;

    // Write this placeholder header at start
    fwrite(header, sizeof(WavHeader), 1, fp);

    return fp;
}

static void finalizeWavFile(FILE* fp, WavHeader* header, uint64_t totalSamples)
{
    if (!fp) return;

    // totalSamples is the total # of float samples (L+R, etc.)
    // subChunk2Size = totalSamples * sizeof(float)
    header->subChunk2Size = (uint32_t)(totalSamples * (header->bitsPerSample / 8));
    header->chunkSize     = 36 + header->subChunk2Size;

    // Seek back to start and rewrite the updated header
    fseek(fp, 0, SEEK_SET);
    fwrite(header, sizeof(WavHeader), 1, fp);

    fclose(fp);
}


/******************************************************************************
 * streamCallback for Audio (with timestamps)
 ******************************************************************************/
static int streamCallback(const void *inputBuffer,
                          void       *outputBuffer,
                          unsigned long framesPerBuffer,
                          const PaStreamCallbackTimeInfo* timeInfo,
                          PaStreamCallbackFlags statusFlags,
                          void *userData)
{
    AudioData *data = (AudioData *)userData;
    const SAMPLE *capturedData = (const SAMPLE *)inputBuffer;
    SAMPLE *playbackData = (SAMPLE *)outputBuffer;

    if (!keepRunning) return paComplete;

    if (capturedData == NULL)
        capturedData = sampleSilence;

    // Local arrays
    static TimestampedSample ringBlock[FRAMES_PER_BUFFER * NUM_CHANNELS];
    static SAMPLE processedBlock[FRAMES_PER_BUFFER * NUM_CHANNELS];

    // Get timing info once per callback block (REALTIME clock)
    struct timespec current_time;
    clock_gettime(CLOCK_REALTIME, &current_time);
    double frame_start_time = (double)current_time.tv_sec
                              + (double)current_time.tv_nsec / 1.0e9;
    double sample_time_interval = 1.0 / (double)SAMPLE_RATE;

    // Choose finalBlock pointer
    const SAMPLE *finalBlock = NULL;

    // 1) Mono replication?
    if (data->monoChannel >= 0)
    {
        static SAMPLE monoBlock[FRAMES_PER_BUFFER * NUM_CHANNELS];
        for (unsigned n = 0; n < framesPerBuffer; n++)
        {
            SAMPLE sel = capturedData[2*n + data->monoChannel];
            monoBlock[2*n + 0] = sel;
            monoBlock[2*n + 1] = sel;
        }
        finalBlock = monoBlock;
    }
    // 2) Normal pass-through if doNoiseCancel=0
    else if (!data->doNoiseCancel)
    {
        finalBlock = capturedData;
    }
    // 3) Noise cancel mode
    else
    {
        float *W          = data->filterCoeffs;
        float *refHistory = data->refHistory;
        int    L          = data->filterLength;
        float  mu         = data->mu;
        int    idx        = data->refIndex;

        for (unsigned n = 0; n < framesPerBuffer; n++)
        {
            float d = capturedData[2*n + 0]; // primary
            float x = capturedData[2*n + 1]; // reference

            refHistory[idx] = x;

            float y = 0.f;
            int histPos = idx;
            for (int k = 0; k < L; k++)
            {
                y += W[k] * refHistory[histPos];
                histPos = (histPos - 1 + L) % L;
            }

            float e = d - y;

            float power = 0.f;
            histPos = idx;
            for (int k = 0; k < L; k++)
            {
                float val = refHistory[histPos];
                power += val * val;
                histPos = (histPos - 1 + L) % L;
            }
            power += EPSILON;

            float normFactor = (mu * e) / power;
            histPos = idx;
            for (int k = 0; k < L; k++)
            {
                W[k] += normFactor * refHistory[histPos];
                histPos = (histPos - 1 + L) % L;
            }

            processedBlock[2*n + 0] = e;
            processedBlock[2*n + 1] = x;

            idx = (idx + 1) % L;
        }
        data->refIndex = idx;
        finalBlock = processedBlock;
    }

    // Write finalBlock to playback
    for (unsigned i = 0; i < framesPerBuffer * NUM_CHANNELS; i++)
    {
        playbackData[i] = GAIN_FACTOR * finalBlock[i];
    }

    // Also store finalBlock into ringBlock (with timestamps)
    if (data->sampleData != NULL)
    {
        ring_buffer_size_t elementsWriteable =
            PaUtil_GetRingBufferWriteAvailable(&data->ringBuffer);
        ring_buffer_size_t elementsToWrite =
            min(elementsWriteable, (ring_buffer_size_t)(framesPerBuffer * NUM_CHANNELS));

        for (unsigned long i = 0; i < elementsToWrite; i++)
        {
            ringBlock[i].sample = finalBlock[i];
            double precise_time = frame_start_time
                                + ((double)(i / NUM_CHANNELS) * sample_time_interval);

            ringBlock[i].timestamp.tv_sec  = (time_t)precise_time;
            ringBlock[i].timestamp.tv_nsec =
                (long)((precise_time - ringBlock[i].timestamp.tv_sec) * 1.0e9);
        }

        PaUtil_WriteRingBuffer(&data->ringBuffer, ringBlock, elementsToWrite);
    }

    (void)timeInfo;
    (void)statusFlags;
    return paContinue;
}


/******************************************************************************
 * Compass / Pitch Reading (unchanged from original)
 ******************************************************************************/
static int fdCompass = -1;
static double pitchValue = 0.0;
static double initialPitch = 0.0;
static int    pitchSet     = 0;

#define COMPASS_DEVICE  "/dev/ttyUSB0"
#define COMPASS_BAUD    B19200

static int configurePort(int fd)
{
    struct termios options;
    if (tcgetattr(fd, &options) < 0)
    {
        perror("tcgetattr");
        return -1;
    }

    cfsetispeed(&options, COMPASS_BAUD);
    cfsetospeed(&options, COMPASS_BAUD);

    options.c_cflag &= ~PARENB; // no parity
    options.c_cflag &= ~CSTOPB; // 1 stop bit
    options.c_cflag &= ~CSIZE;
    options.c_cflag |= CS8;     
    options.c_cflag |= CREAD;   
    options.c_cflag |= CLOCAL;  

    options.c_lflag &= ~(ICANON | ECHO | ECHOE | ISIG);
    options.c_oflag &= ~OPOST;
    options.c_iflag &= ~(IXON | IXOFF | IXANY);

    if (tcsetattr(fd, TCSANOW, &options) < 0)
    {
        perror("tcsetattr");
        return -1;
    }
    return 0;
}

static char pitchBuf[256];
static int  pitchIndex = 0;

static void readCompassPitch(void)
{
    if (fdCompass < 0) return;

    while (1)
    {
        char c;
        int n = read(fdCompass, &c, 1);
        if (n > 0)
        {
            if ((c == '\n') || (c == '\r') ||
                (pitchIndex >= (int)(sizeof(pitchBuf)-1)))
            {
                pitchBuf[pitchIndex] = '\0';
                pitchIndex = 0;

                if (pitchBuf[0] == '$' && pitchBuf[1] == 'C')
                {
                    double heading, pval, roll, temp;
                    unsigned int cs; // checksum
                    int parsed = sscanf(pitchBuf, "$C%lfP%lfR%lfT%lf*%x",
                                        &heading, &pval, &roll, &temp, &cs);
                    if (parsed == 5)
                    {
                        pitchValue = pval;
                        if (!pitchSet)
                        {
                            initialPitch = pitchValue;
                            pitchSet = 1;
                        }
                    }
                }
                memset(pitchBuf, 0, sizeof(pitchBuf));
            }
            else
            {
                pitchBuf[pitchIndex++] = c;
            }
        }
        else
        {
            if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
            {
                perror("read compass");
            }
            break;
        }
    }
}


/******************************************************************************
 * moveCursorUp() - to avoid scrolling
 ******************************************************************************/
static void moveCursorUp(int lines)
{
    if (lines > 0)
        printf("\033[%dA", lines);
}


/******************************************************************************
 * 
 * Microphone Characteristic Storage
 *
 ******************************************************************************/
static double accumAmpDB[46];
static double accumPowDB[46];
static unsigned accumCount[46];


/******************************************************************************
 * Print Usage
 ******************************************************************************/
static void printUsage(const char* progName)
{
    fprintf(stderr,
      "\nUsage:\n"
      "  %s [options] <output.wav>\n\n"
      "Options:\n"
      "  --noise            Enable noise cancellation (NLMS)\n"
      "  --mu=<value>       NLMS step size (default=0.05)\n"
      "  --filterlen=<val>  NLMS filter length (default=128)\n"
      "  --mono=<0|1>       Replicate one channel into both outputs\n"
      "  --bar              Enable ASCII bar display of amplitude/power\n"
      "  --pitch            Read pitch from %s for downward mic characteristic\n"
      "  --duration=<sec>   Automatically stop after <sec> seconds\n"
      "\nExample:\n"
      "  %s --noise --mu=0.03 --filterlen=256 --pitch --duration=10 record.wav\n"
      "\n",
      progName, COMPASS_DEVICE, progName);
}


/******************************************************************************
 * Simple Monotonic Clock Helper
 *
 * We'll use this for the --duration logic, so we don't rely on PortAudio
 ******************************************************************************/
static double getMonotonicSeconds(void)
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;
}


/******************************************************************************
 * Main
 ******************************************************************************/
int main(int argc, char *argv[])
{
    // If no arguments at all => print usage and exit
    if (argc < 2)
    {
        printUsage(argv[0]);
        return 0;
    }

    // parse arguments
    int    doNoiseCancel  = 0;
    float  mu             = DEFAULT_MU;
    int    filterLength   = DEFAULT_FILTER_LENGTH;
    int    monoChannel    = -1;
    int    doBar          = 0;
    int    doPitch        = 0;
    double durationLimit  = 0.0; // 0 => unlimited
    char*  outWavFile     = NULL;

    // We'll loop through argv
    for (int i = 1; i < argc; i++)
    {
        // If it starts with "--", parse as an option
        if (strncmp(argv[i], "--", 2) == 0)
        {
            if (strcmp(argv[i], "--noise") == 0)
            {
                doNoiseCancel = 1;
            }
            else if (strncmp(argv[i], "--mu=", 5) == 0)
            {
                mu = (float)atof(argv[i] + 5);
            }
            else if (strncmp(argv[i], "--filterlen=", 12) == 0)
            {
                filterLength = atoi(argv[i] + 12);
            }
            else if (strncmp(argv[i], "--mono=", 7) == 0)
            {
                int ch = atoi(argv[i] + 7);
                if (ch < 0 || ch >= NUM_CHANNELS)
                {
                    fprintf(stderr, "Error: --mono channel must be 0 or 1.\n");
                    return 1;
                }
                monoChannel = ch;
            }
            else if (strcmp(argv[i], "--bar") == 0)
            {
                doBar = 1;
            }
            else if (strcmp(argv[i], "--pitch") == 0)
            {
                doPitch = 1;
            }
            else if (strncmp(argv[i], "--duration=", 11) == 0)
            {
                durationLimit = atof(argv[i] + 11);
                if (durationLimit < 0.0)
                {
                    fprintf(stderr, "Error: invalid duration.\n");
                    return 1;
                }
            }
            else
            {
                fprintf(stderr, "Unrecognized parameter: %s\n", argv[i]);
                return 1;
            }
        }
        // Otherwise, it should be the output WAV file
        else
        {
            if (outWavFile)
            {
                fprintf(stderr, "Error: multiple output files specified? '%s' and '%s'\n",
                        outWavFile, argv[i]);
                return 1;
            }
            outWavFile = argv[i];
        }
    }

    // If we still have no output WAV => error
    if (!outWavFile)
    {
        fprintf(stderr, "Error: No output WAV file specified.\n");
        return 1;
    }

    // Check if the file name ends in .wav (case-insensitive)
    {
        const char *dot = strrchr(outWavFile, '.');
        if (!dot || strcasecmp(dot, ".wav") != 0)
        {
            fprintf(stderr, "Error: Output file must have .wav extension.\n");
            return 1;
        }
    }

    // Construct timestamps filename by appending ".txt" to the .wav name
    char timestampsFilename[1024];
    snprintf(timestampsFilename, sizeof(timestampsFilename), "%s.txt", outWavFile);

    // Check incompatibilities
    if (monoChannel >= 0 && doNoiseCancel)
    {
        fprintf(stderr, "Error: --mono and --noise are incompatible.\n");
        return 1;
    }

    // set up signals
    signal(SIGINT, sigint_handler);

    // pitch setup if doPitch
    if (doPitch)
    {
        fdCompass = open(COMPASS_DEVICE, O_RDWR | O_NOCTTY | O_NONBLOCK);
        if (fdCompass < 0)
        {
            perror("open compass");
            fprintf(stderr, "Cannot open %s\n", COMPASS_DEVICE);
            // Not strictly fatal, but we'll exit
            return 1;
        }
        if (configurePort(fdCompass) < 0)
        {
            close(fdCompass);
            fdCompass = -1;
            return 1;
        }
    }

    // Print info
    printf("Output WAV file: %s\n", outWavFile);
    printf("Timestamps file: %s\n", timestampsFilename);
    if (monoChannel >= 0)
    {
        printf("Mono replication: channel %d => both.\n", monoChannel);
    }
    else
    {
        printf("Noise cancellation: %s\n", (doNoiseCancel ? "ENABLED" : "DISABLED"));
    }
    if (doBar)   printf("ASCII bar display: ENABLED (no scroll)\n");
    if (doPitch) printf("Pitch reading from %s (downward mic characteristic)\n", COMPASS_DEVICE);
    if (durationLimit > 0.0)
    {
        printf("Will automatically stop after %.1f seconds.\n", durationLimit);
    }

    // set up ring buffer & portaudio
    PaStreamParameters inputParameters, outputParameters;
    PaStream *stream = NULL;
    PaError err;

    AudioData audioData;
    memset(&audioData, 0, sizeof(audioData));

    unsigned long numSamples = NextPowerOf2((unsigned long)(SAMPLE_RATE * 0.5f * NUM_CHANNELS));
    unsigned long numBytes   = numSamples * sizeof(TimestampedSample);

    audioData.sampleData = (TimestampedSample *)malloc(numBytes);
    if (!audioData.sampleData)
    {
        perror("malloc ring buffer");
        return 1;
    }

    TimestampedSample *file_buffer = (TimestampedSample *)malloc(numBytes);
    if (!file_buffer)
    {
        perror("malloc file_buffer");
        free(audioData.sampleData);
        return 1;
    }

    // Initialize ring buffer
    if (PaUtil_InitializeRingBuffer(&audioData.ringBuffer,
                                    sizeof(TimestampedSample),
                                    numSamples,
                                    audioData.sampleData) < 0)
    {
        fprintf(stderr, "Failed to init ring buffer\n");
        free(audioData.sampleData);
        free(file_buffer);
        return 1;
    }

    // Open WAV file
    audioData.wavFile = openWavFile(outWavFile, &audioData.wavHeader);
    if (!audioData.wavFile)
    {
        fprintf(stderr, "Error opening WAV file: %s\n", outWavFile);
        free(audioData.sampleData);
        free(file_buffer);
        return 1;
    }

    // Open timestamps file
    audioData.timestampFile = fopen(timestampsFilename, "w");
    if (!audioData.timestampFile)
    {
        fprintf(stderr, "Error opening timestamps file: %s\n", timestampsFilename);
        free(audioData.sampleData);
        free(file_buffer);
        fclose(audioData.wavFile); // not finalized, but let's close to avoid leaks
        return 1;
    }

    audioData.doNoiseCancel = doNoiseCancel;
    audioData.mu            = mu;
    audioData.filterLength  = filterLength;
    audioData.refIndex      = 0;
    audioData.monoChannel   = monoChannel;
    audioData.totalSamplesWritten = 0; // count of total float samples

    if (doNoiseCancel)
    {
        audioData.filterCoeffs = (float *)calloc(filterLength, sizeof(float));
        audioData.refHistory   = (float *)calloc(filterLength, sizeof(float));
        if (!audioData.filterCoeffs || !audioData.refHistory)
        {
            fprintf(stderr, "NoiseCancel mem fail\n");
            goto error2;
        }
    }
    else
    {
        audioData.filterCoeffs = NULL;
        audioData.refHistory   = NULL;
    }

    err = Pa_Initialize();
    if (err != paNoError)
    {
        fprintf(stderr, "Pa_Initialize error\n");
        goto error2;
    }

    inputParameters.device = Pa_GetDefaultInputDevice();
    inputParameters.channelCount              = NUM_CHANNELS;
    inputParameters.sampleFormat              = PA_SAMPLE_TYPE;
    inputParameters.suggestedLatency          = Pa_GetDeviceInfo(inputParameters.device)->defaultHighInputLatency;
    inputParameters.hostApiSpecificStreamInfo = NULL;

    // For your usage, might be a specific device index
    outputParameters.device = 2;
    outputParameters.channelCount              = NUM_CHANNELS;
    outputParameters.sampleFormat              = PA_SAMPLE_TYPE;
    outputParameters.suggestedLatency          = Pa_GetDeviceInfo(outputParameters.device)->defaultHighOutputLatency;
    outputParameters.hostApiSpecificStreamInfo = NULL;

    err = Pa_OpenStream(&stream,
                        &inputParameters,
                        &outputParameters,
                        SAMPLE_RATE,
                        FRAMES_PER_BUFFER,
                        paClipOff,
                        streamCallback,
                        &audioData);
    if (err != paNoError)
        goto error2;

    err = Pa_StartStream(stream);
    if (err != paNoError)
        goto error1;

    printf("\n=== Started stream... Press CTRL+C to stop. ===\n");

    // We'll track time for --duration using our monotonic clock
    double startTime = getMonotonicSeconds();
    double limitTime = startTime + durationLimit; // if durationLimit=0 => no effect

    unsigned long skipStatsRemaining = STARTUP_SKIP_FRAMES;
    int numBarChannels = (doNoiseCancel || monoChannel >= 0) ? 1 : 2;

    int headingLines = (numBarChannels == 2) ? 1 : 0;
    int linesBase = 4; // amplitude, amplitude(dB), power, power(dB)
    if (doPitch) linesBase += 1; // pitch line
    linesBase += 1; // final blank line
    int linesPerChannel = linesBase + headingLines;
    int totalLines      = linesPerChannel * numBarChannels;

    float sumAbs[2]        = {0.f, 0.f};
    float sumSq[2]         = {0.f, 0.f};
    unsigned long countS[2] = {0, 0};
    float maxAvgAbsSoFar[2] = {1e-9f, 1e-9f};
    float maxAvgSqSoFar[2]  = {1e-9f, 1e-9f};

    unsigned long framesAccumulated = 0;
    const unsigned long FRAMES_PER_UPDATE = (unsigned long)(0.1f * SAMPLE_RATE);

    int firstBarDraw = 1;
    #define BAR_WIDTH 40

    memset(accumAmpDB, 0, sizeof(accumAmpDB));
    memset(accumPowDB, 0, sizeof(accumPowDB));
    memset(accumCount, 0, sizeof(accumCount));

    while (keepRunning)
    {
        // If --duration= was specified, check if we've reached the limit
        if (durationLimit > 0.0)
        {
            double now = getMonotonicSeconds();
            if (now >= limitTime)
            {
                keepRunning = 0;
                break;
            }
        }

        // If doPitch => read from compass
        if (doPitch)
        {
            readCompassPitch();
        }

        // Check ring buffer
        size_t itemsToRead = PaUtil_GetRingBufferReadAvailable(&audioData.ringBuffer);
        if (itemsToRead > 0)
        {
            ring_buffer_size_t itemsRead =
                PaUtil_ReadRingBuffer(&audioData.ringBuffer, file_buffer, itemsToRead);

            // 1) Write to WAV & timestamps
            for (size_t i = 0; i < itemsRead; i++)
            {
                // Each sample is float (4 bytes)
                fwrite(&file_buffer[i].sample, sizeof(float), 1, audioData.wavFile);
                audioData.totalSamplesWritten += 1;

                fprintf(audioData.timestampFile, "%ld.%09ld\n",
                        (long)file_buffer[i].timestamp.tv_sec,
                        (long)file_buffer[i].timestamp.tv_nsec);
            }

            // 2) If no bar => skip stats
            if (!doBar)
            {
                Pa_Sleep(80);
                continue;
            }

            // Otherwise do stats
            unsigned long chunkFrames = (unsigned long)(itemsRead / NUM_CHANNELS);

            if (skipStatsRemaining > 0)
            {
                if (skipStatsRemaining >= chunkFrames)
                {
                    skipStatsRemaining -= chunkFrames;
                    Pa_Sleep(80);
                    continue;
                }
                else
                {
                    unsigned long partial = skipStatsRemaining;
                    skipStatsRemaining = 0;
                    unsigned long usedFrames = chunkFrames - partial;
                    memmove(file_buffer,
                            file_buffer + partial*NUM_CHANNELS,
                            (usedFrames * NUM_CHANNELS) * sizeof(TimestampedSample));
                    chunkFrames = usedFrames;
                }
            }

            // Accumulate amplitude, power stats
            for (unsigned long f = 0; f < chunkFrames; f++)
            {
                float s0 = file_buffer[f*NUM_CHANNELS + 0].sample;
                float s1 = file_buffer[f*NUM_CHANNELS + 1].sample;

                if (numBarChannels == 1)
                {
                    sumAbs[0] += fabsf(s0);
                    sumSq[0]  += (s0*s0);
                    countS[0] += 1;
                }
                else
                {
                    sumAbs[0] += fabsf(s0);
                    sumSq[0]  += (s0*s0);
                    countS[0] += 1;

                    sumAbs[1] += fabsf(s1);
                    sumSq[1]  += (s1*s1);
                    countS[1] += 1;
                }
            }
            framesAccumulated += chunkFrames;

            // Every 100ms => print bars
            if (framesAccumulated >= FRAMES_PER_UPDATE)
            {
                if (!firstBarDraw)
                {
                    moveCursorUp(totalLines);
                }
                else
                {
                    firstBarDraw = 0;
                }

                for (int ch = 0; ch < numBarChannels; ch++)
                {
                    if (numBarChannels == 2)
                    {
                        printf("Channel %d:\n", ch);  
                    }

                    if (countS[ch] == 0)
                    {
                        // blank lines
                        printf("Amplitude           \n");
                        printf("Amplitude (dB)      \n");
                        printf("Power               \n");
                        printf("Power (dB)          \n");
                        if (doPitch) printf("Pitch angle         \n");
                        printf("\n");
                        continue;
                    }

                    float avgAmp = sumAbs[ch] / (float)countS[ch];
                    float avgPow = sumSq[ch]  / (float)countS[ch];

                    if (avgAmp > maxAvgAbsSoFar[ch]) maxAvgAbsSoFar[ch] = avgAmp;
                    if (avgPow > maxAvgSqSoFar[ch])  maxAvgSqSoFar[ch]  = avgPow;

                    float ratioAmp = avgAmp / maxAvgAbsSoFar[ch];
                    float ratioPow = avgPow / maxAvgSqSoFar[ch];

                    float ampDB = 20.f * log10f(ratioAmp + 1e-12f);
                    if (ampDB < -40.f) ampDB = -40.f;
                    float powDB = 10.f * log10f(ratioPow + 1e-12f);
                    if (powDB < -40.f) powDB = -40.f;

                    int barAmp    = (int)(ratioAmp * BAR_WIDTH + 0.5f);
                    int barAmpdB  = (int)(((ampDB + 40.f)/40.f)*BAR_WIDTH + 0.5f);
                    int barPow    = (int)(ratioPow * BAR_WIDTH + 0.5f);
                    int barPowdB  = (int)(((powDB + 40.f)/40.f)*BAR_WIDTH + 0.5f);

                    #define CLAMP_B(v) if(v<0) v=0; else if(v>BAR_WIDTH)v=BAR_WIDTH
                    CLAMP_B(barAmp);
                    CLAMP_B(barAmpdB);
                    CLAMP_B(barPow);
                    CLAMP_B(barPowdB);

                    char barStrAmp[BAR_WIDTH+1];   memset(barStrAmp,   '*', barAmp);   barStrAmp[barAmp]   = '\0';
                    char barStrAmpdB[BAR_WIDTH+1]; memset(barStrAmpdB, '*', barAmpdB); barStrAmpdB[barAmpdB] = '\0';
                    char barStrPow[BAR_WIDTH+1];   memset(barStrPow,   '*', barPow);   barStrPow[barPow]   = '\0';
                    char barStrPowdB[BAR_WIDTH+1]; memset(barStrPowdB, '*', barPowdB); barStrPowdB[barPowdB] = '\0';

                    printf("Amplitude           %-*.*s (%.2f)\n",
                           BAR_WIDTH, BAR_WIDTH, barStrAmp,   ratioAmp);
                    printf("Amplitude (dB)      %-*.*s (%.1f dB)\n",
                           BAR_WIDTH, BAR_WIDTH, barStrAmpdB, ampDB);
                    printf("Power               %-*.*s (%.2f)\n",
                           BAR_WIDTH, BAR_WIDTH, barStrPow,   ratioPow);
                    printf("Power (dB)          %-*.*s (%.1f dB)\n",
                           BAR_WIDTH, BAR_WIDTH, barStrPowdB, powDB);

                    if (doPitch)
                    {
                        double pval = pitchValue;
                        if (!pitchSet) pval = 0.0;
                        double diff = pval - initialPitch;
                        double ratioP = 0.0;
                        if (pval < -90.0) pval = -90.0;
                        if (pval >  90.0) pval =  90.0;

                        ratioP = (pval + 90.0)/180.0;
                        int barPitch = (int)(ratioP * BAR_WIDTH + 0.5f);
                        if (barPitch<0) barPitch=0; else if(barPitch>BAR_WIDTH) barPitch=BAR_WIDTH;

                        char barStrPitch[BAR_WIDTH+1];
                        memset(barStrPitch, '*', barPitch);
                        barStrPitch[barPitch] = '\0';

                        printf("Pitch angle         %-*.*s (%.2f deg)\n",
                               BAR_WIDTH, BAR_WIDTH, barStrPitch, pitchValue);

                        // If downward: difference < 0, up to -45
                        if (diff < 0 && diff >= -45.0)
                        {
                            int angleIndex = -(int)round(diff);
                            if (angleIndex >= 0 && angleIndex <= 45)
                            {
                                accumAmpDB[angleIndex] += ampDB;
                                accumPowDB[angleIndex] += powDB;
                                accumCount[angleIndex] += 1;
                            }
                        }
                    }

                    printf("\n");

                    sumAbs[ch] = 0.f;
                    sumSq[ch]  = 0.f;
                    countS[ch] = 0;
                }
                framesAccumulated = 0;
            }
        }
        Pa_Sleep(80);
    }

    // Stop stream
    err = Pa_StopStream(stream);
    if (err != paNoError) goto error1;
    printf("Stopped stream.\n");

    // If doPitch => write mic_characteristics.tsv
    if (doPitch)
    {
        FILE *fchar = fopen("mic_characteristics.tsv", "w");
        if (fchar)
        {
            for (int i = 0; i <= 45; i++)
            {
                if (accumCount[i] > 0)
                {
                    double meanAmp = accumAmpDB[i]/accumCount[i];
                    double meanPow = accumPowDB[i]/accumCount[i];
                    fprintf(fchar, "%d\t%.2f\t%.2f\n", i, meanAmp, meanPow);
                }
            }
            fclose(fchar);
            printf("Wrote mic_characteristics.tsv\n");
        }
        else
        {
            perror("fopen mic_characteristics.tsv");
        }
    }

    // Cleanup
    Pa_CloseStream(stream);
    Pa_Terminate();

    // finalizeWavFile => fix header sizes, then close
    finalizeWavFile(audioData.wavFile, &audioData.wavHeader, audioData.totalSamplesWritten);

    if (audioData.timestampFile)  fclose(audioData.timestampFile);
    if (audioData.filterCoeffs)   free(audioData.filterCoeffs);
    if (audioData.refHistory)     free(audioData.refHistory);
    if (audioData.sampleData)     free(audioData.sampleData);
    if (file_buffer)              free(file_buffer);
    if (fdCompass >= 0)          close(fdCompass);

    printf("Terminated.\n");
    return 0;

error1:
    Pa_Terminate();
    // we must still finalize the WAV file so it is not corrupt,
    // but partial data is unknown. We'll do minimal fix:
    finalizeWavFile(audioData.wavFile, &audioData.wavHeader, audioData.totalSamplesWritten);
    if (audioData.timestampFile) fclose(audioData.timestampFile);
    if (audioData.filterCoeffs) free(audioData.filterCoeffs);
    if (audioData.refHistory)   free(audioData.refHistory);
    if (audioData.sampleData)   free(audioData.sampleData);
    if (file_buffer)            free(file_buffer);
    if (fdCompass >= 0)         close(fdCompass);
    return -3;

error2:
    if (stream)
    {
        Pa_AbortStream(stream);
        Pa_CloseStream(stream);
    }
    Pa_Terminate();
    // finalize partial
    finalizeWavFile(audioData.wavFile, &audioData.wavHeader, audioData.totalSamplesWritten);
    if (audioData.timestampFile) fclose(audioData.timestampFile);
    if (audioData.filterCoeffs)  free(audioData.filterCoeffs);
    if (audioData.refHistory)    free(audioData.refHistory);
    if (audioData.sampleData)    free(audioData.sampleData);
    if (file_buffer)             free(file_buffer);
    if (fdCompass >= 0)          close(fdCompass);
    fprintf(stderr, "An error occurred while using the PortAudio stream.\n");
    return -1;
}
