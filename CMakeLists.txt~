cmake_minimum_required(VERSION 3.10)
project(MyAudioProject)

# Set the C standard to C99
set(CMAKE_C_STANDARD 99)

# Specify the source files for the two programs
add_executable(pa_devs src/pa_devs.c)
add_executable(record_example src/record_example.c)
add_executable(test_fftw src/test_fftw.c)

# Use a relative path to pa_ringbuffer.c (instead of /home/pi/.../pa_ringbuffer.c)
add_executable(continuous_capture
    src/continuous_capture.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

add_executable(paex_read_write_wire src/paex_read_write_wire.c)
add_executable(paex_pink src/paex_pink.c)
add_executable(thread_example src/thread_example.c)

add_executable(basis_audio_program
    src/basis_audio_program.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

add_executable(basis_audio_program_processing
    src/basis_audio_program_processing.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

add_executable(basis_audio_program_threads
    src/basis_audio_program_threads.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

add_executable(basis_audio_program_timestamps
    src/basis_audio_program_timestamps.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

add_executable(aoa_test src/aoa_test.c)

add_executable(basis_audio_program_adctimestamps
    src/basis_audio_program_adctimestamps.c
    lib/portaudio/src/common/pa_ringbuffer.c
)

# Link libraries
target_link_libraries(pa_devs portaudio asound)
target_link_libraries(test_fftw sndfile fftw3 m)
target_link_libraries(paex_read_write_wire portaudio asound)
target_link_libraries(paex_pink portaudio asound)
target_link_libraries(thread_example pthread)
target_link_libraries(aoa_test sndfile fftw3 m)
target_link_libraries(record_example portaudio asound m pthread)
target_link_libraries(continuous_capture portaudio asound m pthread)




# Include directories (relative)
target_include_directories(continuous_capture PRIVATE
    lib/include
    lib/portaudio/src/common
)
target_include_directories(basis_audio_program PRIVATE
    lib/include
    lib/portaudio/src/common
)
target_include_directories(basis_audio_program_processing PRIVATE
    lib/include
    lib/portaudio/src/common
)
target_include_directories(basis_audio_program_threads PRIVATE
    lib/include
    lib/portaudio/src/common
)
target_include_directories(basis_audio_program_timestamps PRIVATE
    lib/include
    lib/portaudio/src/common
)
target_include_directories(basis_audio_program_adctimestamps PRIVATE
    lib/include
    lib/portaudio/src/common
)

# More link libraries
target_link_libraries(basis_audio_program portaudio asound m)
target_link_libraries(basis_audio_program_processing portaudio asound m)
target_link_libraries(basis_audio_program_threads portaudio sndfile m pthread)
target_link_libraries(basis_audio_program_timestamps portaudio sndfile m pthread)
target_link_libraries(basis_audio_program_adctimestamps portaudio sndfile m pthread)

# Set the output directory for the binaries
set_target_properties(
    pa_devs
    paex_pink
    thread_example
    basis_audio_program
    basis_audio_program_processing
    basis_audio_program_threads
    basis_audio_program_timestamps
    aoa_test
    basis_audio_program_adctimestamps
    PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
)
